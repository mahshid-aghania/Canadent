# ── Supabase ───────────────────────────────────────────────────────────────
# Provision Supabase (Vercel Marketplace or supabase.com), then copy these from
# the project's API settings. Do NOT commit real values — copy this file to
# .env.local and fill it in, or run `vercel env pull`.

# Public — safe to expose to the browser (governed by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Bypasses RLS. Used by the webhook.
SUPABASE_SERVICE_ROLE_KEY=

# ── Already used by the app (listed for completeness) ────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# NEXT_PUBLIC_BASE_URL=
